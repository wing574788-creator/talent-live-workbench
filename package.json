{
  "name": "talent-live-workbench",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @workbench/server db:generate",
    "db:migrate": "pnpm --filter @workbench/server db:migrate",
    "db:seed": "pnpm --filter @workbench/server db:seed",
    "backup": "pnpm --filter @workbench/server backup:cli",
    "agent:spike": "pnpm --filter @workbench/server agent:spike",
    "samples:import": "pnpm --filter @workbench/server samples:import",
    "scan:secrets": "node scripts/scan-secrets.mjs --all",
    "hooks": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
